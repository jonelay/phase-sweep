{
  "meta": {
    "version": 1,
    "prefix": "vs:",
    "target": "document"
  },
  "events": {
    "tab-change": {
      "detail": {
        "tab_id": "string",
        "params": "Record<string, string>"
      },
      "description": "Active tab changed (user click, hash navigation, or keyboard); params from hash query"
    },
    "theme-change": {
      "detail": {
        "theme": "string"
      },
      "description": "Light/dark variant changed; panels re-read chart tokens and redraw"
    },
    "palette-change": {
      "detail": {
        "palette": "string",
        "categorical": "string"
      },
      "description": "Categorical series set changed; every slot re-hues at once"
    },
    "sequential-change": {
      "detail": {
        "sequential": "string"
      },
      "description": "Sequential ramp selection changed"
    },
    "sidebar-toggle": {
      "detail": {
        "collapsed": "boolean"
      }
    },
    "panel-toggle": {
      "detail": {
        "panel_id": "string",
        "collapsed": "boolean"
      }
    },
    "panel-maximize": {
      "detail": {
        "panel_id": "string",
        "maximized": "boolean"
      }
    },
    "panel-reorder": {
      "detail": {
        "tab_id": "string",
        "order": "string[]"
      }
    },
    "connection-change": {
      "detail": {
        "state": "string"
      },
      "description": "Provider connection state: connected | connecting | disconnected"
    },
    "job-progress": {
      "detail": {
        "job_id": "string",
        "completed": "integer",
        "total": "integer",
        "latest_result_id": "string | null"
      }
    },
    "job-complete": {
      "detail": {
        "job_id": "string",
        "result_ids": "string[]"
      }
    },
    "job-failed": {
      "detail": {
        "job_id": "string",
        "error": "string"
      }
    },
    "job-cancelled": {
      "detail": {
        "job_id": "string"
      }
    },
    "result-routed": {
      "detail": {
        "result_id": "string"
      },
      "description": "A result was fetched and dispatched to panels; status bar stamps the time"
    },
    "export-request": {
      "detail": {
        "scope": "string"
      },
      "description": "User asked for a PNG export of the given scope (e.g. active tab)"
    }
  }
}
